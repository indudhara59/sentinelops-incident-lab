# Copy to .env for local API development. Never commit real secrets.
SENTINELOPS_ENVIRONMENT=development
SENTINELOPS_LOG_LEVEL=INFO
SENTINELOPS_CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000

# Phase 7 Atlas persistence. Use an online Atlas cluster; do not use localhost.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=sentinelops_development

# Auth.js. Generate AUTH_SECRET with `npx auth secret`; never reuse this placeholder.
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_GOOGLE_ID=replace-with-google-oauth-client-id
AUTH_GOOGLE_SECRET=replace-with-google-oauth-client-secret
# AUTH_URL=https://your-production-origin.example
# AUTH_TRUST_HOST=true
