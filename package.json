{
  "name": "sentinelops-incident-lab",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @sentinelops/web dev",
    "dev:web": "pnpm --filter @sentinelops/web dev",
    "dev:api": "cd services/api && uvicorn app.main:app --reload",
    "build": "pnpm --filter @sentinelops/web build",
    "lint": "pnpm lint:web && pnpm lint:api",
    "lint:web": "pnpm --filter @sentinelops/web lint",
    "lint:api": "cd services/api && ruff check .",
    "typecheck": "pnpm typecheck:web && pnpm typecheck:shared && pnpm typecheck:api",
    "typecheck:web": "pnpm --filter @sentinelops/web typecheck",
    "typecheck:shared": "pnpm --filter @sentinelops/shared typecheck",
    "typecheck:api": "cd services/api && mypy app",
    "test": "pnpm test:web && pnpm test:api",
    "test:web": "pnpm --filter @sentinelops/web test",
    "test:api": "cd services/api && pytest",
    "format": "prettier --write . && cd services/api && ruff format .",
    "format:check": "prettier --check . && cd services/api && ruff format --check .",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "prettier": "^3.7.4"
  }
}
